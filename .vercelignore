# Never exclude: api/, public/, vercel.json, api/requirements.txt
.git
.vercel
.venv
__pycache__/
**/__pycache__/
.pytest_cache
.streamlit
.dist
data/
dist/
docs/
src/
views/
static/
tests/
scripts/
node_modules/
*.log
*.bat
*.ps1
.env
.env.*
!.env.example
# Root Python env specs conflict with Vercel's managed Python for api/;
# the serverless function installs strictly from api/requirements.txt
# (leading slash = root only, so api/requirements.txt still ships!)
/pyproject.toml
/uv.lock
/requirements.txt
/.python-version
/runtime.txt
